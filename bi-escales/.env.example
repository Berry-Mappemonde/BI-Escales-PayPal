PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# Listener PayPal must call. Register this exact URL in the sandbox dashboard.
# https://bi-escales-api.onrender.com/api/escales/webhooks/paypal
ESCALES_PUBLIC_URL=https://bi-escales-api.onrender.com
# Extra browser origins, comma-separated. Vite (5173) is always allowed.
ESCALES_CORS_ORIGINS=
ESCALES_ENABLED=
ESCALES_ADMIN_KEY=
ESCALES_STORE=
MONGO_URL=
DB_NAME=bi_escales
ESCALES_WEBHOOKS_ENABLED=
ESCALES_ZAPIER_ENABLED=
ESCALES_TOOLKIT_ENABLED=
ESCALES_NAVIGUIDE_ENABLED=
ESCALES_NAVIGUIDE_JSON=
NAVIGUIDE_API_URL=http://127.0.0.1:8010
ESCALES_ELASTIC_ENABLED=
ESCALES_ELASTIC_URL=
ESCALES_KERNEL_ENABLED=
ESCALES_KERNEL_URL=
ESCALES_CHANNEL3_ENABLED=
ESCALES_BRYNTUM_ENABLED=
ESCALES_VAULT_ENABLED=
ESCALES_VAULT_RETURN_URL=
ESCALES_VAULT_CANCEL_URL=
# Classic AUTHORIZE redirect. The browser may send its own origin on POST /pledges.
ESCALES_RETURN_URL=https://bi-escales-api.onrender.com/?paypal=return
ESCALES_CANCEL_URL=https://bi-escales-api.onrender.com/?paypal=cancel
ESCALES_LLM_ENABLED=
ESCALES_LLM_NEBIUS_ENABLED=false
# development (default): no captain rate limit and no LLM daily cap.
# production turns both on. ESCALES_RATE_LIMIT_ENABLED overrides either way when set.
ESCALES_ENV=development
ESCALES_RATE_LIMIT_ENABLED=
ESCALES_CAPTAIN_RATE_PER_MINUTE=10
ESCALES_CAPTAIN_RATE_PER_DAY=100
ESCALES_LLM_DAILY_CAP=100
ESCALES_LLM_TIMEOUT_S=10
ESCALES_LLM_TIMEOUT_NIM_S=
ESCALES_LLM_TIMEOUT_NIM_FALLBACK_S=8
ESCALES_LLM_TIMEOUT_OPENROUTER_S=
ESCALES_LLM_TIMEOUT_ANTHROPIC_S=
ESCALES_LLM_TIMEOUT_TOKENFACTORY_S=
NVIDIA_API_KEY=
# Benchmarked NIM defaults. NIM_TEMPERATURE stays empty so each call
# sets its own temperature: chat 0.3, reports 0.2, JSON 0.
# The JSON schema is not part of NIM_EXTRA_BODY. ask_json sends it on that request only.
# A public Super id (with or without -vl) returns 404. The lightning id is the fallback hop only.
# Leave NIM_MODEL on the private Super id. On Render, set or clear the same variable.
NIM_MODEL=private/nvidia/nemotron-3.5-super-120b-a12b
NIM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_TEMPERATURE=
NIM_MAX_TOKENS=400
NIM_TOP_P=0.95
NIM_REASONING=none
NIM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
NEBIUS_API_KEY=
HELLOASSO_MEMBERSHIP_URL=
