PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# Listener PayPal must call. Register this exact URL in the sandbox dashboard.
# https://bi-escales-api.onrender.com/api/escales/webhooks/paypal
ESCALES_PUBLIC_URL=https://bi-escales-api.onrender.com
# Extra browser origins, comma-separated. Vite (5173) is always allowed.
ESCALES_CORS_ORIGINS=
# Mount /api/escales routes. Set to 1 for local development / demo.
ESCALES_ENABLED=
ESCALES_ADMIN_KEY=
# Store backend: memory (in-memory demo, no MongoDB required) or mongo.
ESCALES_STORE=
MONGO_URL=
DB_NAME=bi_escales
# Read-only Blue Intelligence marina enrichment (database blueintel_db, collection marinas).
BI_MARINAS_MONGODB_URI=
BI_MARINAS_MONGODB_DB_NAME=blueintel_db
ESCALES_WEBHOOKS_ENABLED=
ESCALES_ZAPIER_ENABLED=
ESCALES_TOOLKIT_ENABLED=
ESCALES_NAVIGUIDE_ENABLED=
ESCALES_NAVIGUIDE_JSON=
NAVIGUIDE_API_URL=http://127.0.0.1:8010
ESCALES_ELASTIC_ENABLED=
ESCALES_ELASTIC_URL=
ESCALES_KERNEL_ENABLED=
ESCALES_KERNEL_URL=
ESCALES_CHANNEL3_ENABLED=
# Channel3 catalogue + treasurer wishlists (requires ESCALES_CHANNEL3_ENABLED).
ESCALES_WISHLISTS_ENABLED=
CHANNEL3_API_KEY=
# Optional comma-separated catalog queries when Channel3 is enabled (issue #26).
ESCALES_CHANNEL3_GEAR_QUERIES=
CHANNEL3_MCP_URL=https://ucp.trychannel3.com/mcp
ESCALES_BRYNTUM_ENABLED=
ESCALES_VAULT_ENABLED=
# Advanced card checkout (JS SDK card-fields). Off by default.
ESCALES_CARD_FIELDS_ENABLED=
# Save the payment method during a near-departure AUTHORIZE checkout (store_in_vault ON_SUCCESS).
ESCALES_VAULT_ON_PURCHASE_ENABLED=
# Sandbox-only: open treasurer queue/review/capture/void without x-admin-key (requires PAYPAL_ENV=sandbox).
ESCALES_DEMO_TREASURER=
# Apple Pay / Google Pay SDK components (requires sandbox domain registration).
ESCALES_WALLET_PAY_ENABLED=
# Optional override; default is backend/static/.well-known/apple-developer-merchantid-domain-association
ESCALES_APPLE_PAY_DOMAIN_ASSOCIATION_FILE=
# Marina multiparty platform fees (berth only). Requires partner-referrals ACTIVE sellers.
ESCALES_PLATFORM_FEES_ENABLED=
ESCALES_PLATFORM_FEE_EUR=3.00
ESCALES_PLATFORM_PAYEE_MERCHANT_ID=
ESCALES_MARINA_SELLER_MERCHANT_ID=
# Marina net paid via PayPal Payouts after berth capture (when multiparty fees are off). Default on.
ESCALES_MARINA_PAYOUTS_ENABLED=1
ESCALES_MARINA_PAYOUT_EMAIL=
ESCALES_VAULT_RETURN_URL=
ESCALES_VAULT_CANCEL_URL=
ESCALES_SUBSCRIPTION_RETURN_URL=
ESCALES_SUBSCRIPTION_CANCEL_URL=
# Classic AUTHORIZE redirect. The browser may send its own origin on POST /pledges.
ESCALES_RETURN_URL=https://bi-escales-api.onrender.com/?paypal=return
ESCALES_CANCEL_URL=https://bi-escales-api.onrender.com/?paypal=cancel
ESCALES_LLM_ENABLED=
ESCALES_LLM_NEBIUS_ENABLED=false
# Captain chat + review rate limit (production default). Override with ESCALES_RATE_LIMIT_ENABLED.
# Optional per-browser session header: X-Escales-Session (see frontend escalesSession.ts).
# production turns both on. ESCALES_RATE_LIMIT_ENABLED overrides either way when set.
# Optional simulated voyage clock overrides (development / tests). Empty uses real UTC.
ESCALES_CLOCK_NOW=
ESCALES_CLOCK_START=
ESCALES_ENV=development
ESCALES_RATE_LIMIT_ENABLED=
ESCALES_CAPTAIN_RATE_PER_MINUTE=10
ESCALES_CAPTAIN_RATE_PER_DAY=100
ESCALES_TRUSTED_PROXY_HOPS=1
ESCALES_LLM_DAILY_CAP=100
# Optional Mongo collection / counter name for the production LLM daily cap (requires MONGO_URL).
ESCALES_LLM_DAILY_COUNTERS_COLLECTION=
ESCALES_LLM_DAILY_COUNTER_NAME=
ESCALES_LLM_TIMEOUT_S=10
# Empty means 20 s for the Super hop and 10 s for Lightning.
ESCALES_LLM_TIMEOUT_NIM_S=
ESCALES_LLM_TIMEOUT_NIM_FALLBACK_S=10
ESCALES_LLM_TIMEOUT_OPENROUTER_S=
ESCALES_LLM_TIMEOUT_ANTHROPIC_S=
ESCALES_LLM_TIMEOUT_TOKENFACTORY_S=
NVIDIA_API_KEY=
# Benchmarked NIM defaults. NIM_TEMPERATURE stays empty so each call
# sets its own temperature: chat 0.3, reports 0.2, JSON 0.
# The JSON schema is not part of NIM_EXTRA_BODY. ask_json sends it on that request only.
# A public Super id (with or without -vl) returns 404. The lightning id is the fallback hop only.
# Leave NIM_MODEL on the private Super id. On Render, set or clear the same variable.
NIM_MODEL=private/nvidia/nemotron-3.5-super-120b-a12b
NIM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_TEMPERATURE=
NIM_MAX_TOKENS=400
NIM_TOP_P=0.95
# Not sent. reasoning_effort is omitted; enable_thinking stays false.
NIM_REASONING=none
NIM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
OPENROUTER_API_KEY=
# Empty uses the free router openrouter/free. Do not set a paid model here.
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=https://github.com/Berry-Mappemonde/BI-Escales-PayPal
OPENROUTER_APP_TITLE=BI Escales
ANTHROPIC_API_KEY=
NEBIUS_API_KEY=

# Optional LangSmith tracing of captain.chat / captain.review / LLM hops.
# Off unless LANGSMITH_TRACING=true and LANGSMITH_API_KEY is set. Inputs and
# outputs are redacted (names, emails, payer data, card numbers, treasurer key).
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
