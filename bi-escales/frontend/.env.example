# Copier vers .env.local — ne jamais committer
# Identifiant client PayPal public (le même que PAYPAL_CLIENT_ID). Sans lui le bouton ne s'affiche pas.
VITE_PAYPAL_CLIENT_ID=
VITE_ENABLE_AG_GRID=0
# Vide : le navigateur appelle /api sur la même origine.
# `vite` et `vite preview` proxifient /api vers https://bi-escales-api.onrender.com
# (surcharge : VITE_API_PROXY_TARGET). Une origine absolue n'a pas de CORS sur l'API.
VITE_API_BASE=
# Vide : la fiche marina vient du snapshot. Une URL ne part qu'avec cette variable.
VITE_NAVIGUIDE_API_URL=
