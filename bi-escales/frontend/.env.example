# Copier vers .env.local — ne jamais committer
VITE_ENABLE_AG_GRID=0
# Tableau de bord AG Studio. 0 par défaut : le module n'est jamais importé.
VITE_ENABLE_AG_STUDIO=0
# Clé de licence AG Grid / AG Studio. Vide = essai local (filigrane). Ne jamais committer la valeur.
VITE_AG_GRID_LICENSE_KEY=
# Proxy LLM optionnel pour l'agent Studio. Vide = pas d'appel réseau. La clé du fournisseur reste sur le proxy.
VITE_AG_STUDIO_LLM_ENDPOINT=
# Vide en local : le navigateur appelle /api sur la même origine.
# `vite` et `vite preview` proxifient /api vers https://bi-escales-api.onrender.com
# Surcharge pour backend local (ex: http://127.0.0.1:8000) :
VITE_API_PROXY_TARGET=
# Le service Render sert la page et l'API sur le même hôte.
# Laisser VITE_API_BASE vide : les appels restent des URL relatives.
VITE_API_BASE=
# Vide : la fiche marina vient du snapshot. Une URL ne part qu'avec cette variable.
VITE_NAVIGUIDE_API_URL=
