# Copy to .env.local — never commit real values
VITE_ENABLE_AG_GRID=0
# AG Studio dashboard. Default 0: the module is never imported.
VITE_ENABLE_AG_STUDIO=0
# AG Grid / AG Studio license key. Empty = local trial (watermark). Never commit the value.
VITE_AG_GRID_LICENSE_KEY=
# Optional LLM proxy for Studio agent. Empty = no network call. Provider key stays on the proxy.
VITE_AG_STUDIO_LLM_ENDPOINT=
# Empty locally: the browser calls /api on the same origin.
# `npm run dev` (port 5173) proxies /api to the backend on http://localhost:8000 by default.
# Override to hit test2 or another host, e.g. https://bi-escales-api-test2.onrender.com
VITE_API_PROXY_TARGET=
# Render serves the shell and API on one host — leave VITE_API_BASE empty for relative /api URLs.
VITE_API_BASE=
# Empty: marina sheet uses the snapshot. A URL is used only when this variable is set.
VITE_NAVIGUIDE_API_URL=
