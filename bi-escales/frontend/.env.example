# Copier vers .env.local — ne jamais committer
# Frontend build-time partner (see README). Default off keeps the HTML treasurer queue.
VITE_ENABLE_AG_GRID=0
# Vide en local : le navigateur appelle /api sur la même origine.
# `vite` et `vite preview` proxifient /api vers https://bi-escales-api.onrender.com
# (surcharge : VITE_API_PROXY_TARGET).
# Le service Render sert la page et l'API sur le même hôte.
# Laisser VITE_API_BASE vide : les appels restent des URL relatives.
VITE_API_BASE=
# Vide : la fiche marina vient du snapshot. Une URL ne part qu'avec cette variable.
VITE_NAVIGUIDE_API_URL=
