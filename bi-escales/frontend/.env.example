# Copier vers .env.local — ne jamais committer
VITE_PAYPAL_CLIENT_ID=
VITE_ENABLE_AG_GRID=0
# Tableau de bord AG Studio (lot L3b). 0 par défaut : retirer le module ne change pas l’app.
VITE_ENABLE_AG_STUDIO=0
# Clé de licence AG Grid / AG Studio. Vide = essai local (filigrane). Ne jamais committer la valeur.
VITE_AG_GRID_LICENSE_KEY=
# Proxy LLM optionnel pour l’agent Studio. Vide = pas d’appel réseau. La clé du fournisseur reste sur le proxy.
VITE_AG_STUDIO_LLM_ENDPOINT=
VITE_API_BASE=
